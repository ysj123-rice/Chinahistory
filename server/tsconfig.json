{
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
